datasource db {
  provider = "postgresql" // ou "sqlite", conforme o seu projeto utiliza
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dealer {
  id                  String   @id @default(uuid())
  whatsapp            String   @unique
  name                String?
  email               String?  @unique
  documentType        String?
  document            String?  @unique
  companyName         String?
  addressZip          String?
  addressStreet       String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  role                String?
  balance             Float    @default(0.0)
  registrationStep    String   @default("WAITING_NAME")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}